{
  "name": "kuis-javascript",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node backend/server.js\" \"vite frontend --config frontend/vite.config.js\"",
    "build": "vite build frontend --config frontend/vite.config.js",
    "start": "node backend/server.js",
    "preview": "vite preview frontend --config frontend/vite.config.js",
    "security:audit": "npm audit --audit-level=moderate"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "concurrently": "^10.0.5",
    "dotenv": "^17.2.2",
    "express": "^5.2.1",
    "html2canvas": "^1.4.1",
    "jquery": "^4.0.0",
    "mammoth": "^1.13.0",
    "multer": "^2.4.0",
    "pdf-parse": "^1.1.1"
  }
}
